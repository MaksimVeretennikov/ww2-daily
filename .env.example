# Copy these into the routine's Environment variables (claude.ai/code routine settings).
# .env format: KEY=value per line, no quotes around values.

# --- Telegram (required) ---
# Token from @BotFather for the bot that posts to the channel.
TELEGRAM_BOT_TOKEN=
# Channel to post into. The bot must be an admin with posting rights.
TELEGRAM_CHANNEL=@ww2_dnevnik

# --- X cross-post (optional) ---
# Two ways to also post the short English version to X. Polls are never
# cross-posted (Buffer/X can't do quiz polls).
#
# (A) Buffer with photo, free: a tiny make.com scenario (Webhook -> Buffer
#     Create Status with media.picture). Paste its webhook URL here. The routine
#     POSTs {"text": ..., "image_url": ...} to it. Takes priority over the X API.
BUFFER_WEBHOOK_URL=
#
# (B) X API directly (with photo, pay-per-use ~$0.01/post). Set X_ENABLED=1 and
#     fill the keys. Used only if BUFFER_WEBHOOK_URL is empty.
X_ENABLED=0
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- VK cross-post (optional) ---
# Mirror every publication (daily post, evening rubric, daily poll) to a VK
# community you own. Either a COMMUNITY key (Управление → Работа с API →
# Ключи доступа, rights «Стена» + «Фотографии»; posts go out text-only and
# quizzes as text) or a USER token with scopes wall,photos,groups,offline
# (photos + real polls). The module detects which one it got. Check it with
# scripts/vk_check.py.
VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Optional footer appended to VK posts, e.g. a link back to Telegram:
VK_FOOTER=
# "all" mirrors posts, rubrics and the quiz; "polls" mirrors the quiz only
# (use it when an external Telegram→VK crossposter already copies the posts).
VK_MIRROR=all
# VK polls have no quiz mode: the poll closes after this many hours (0 = never)
# and the answer is revealed next day as a community comment under it.
VK_POLL_HOURS=24

# --- Behaviour ---

# Public base URL of docs/ (GitHub Pages), where docs/feed.xml and docs/img/ live.
FEED_BASE_URL=https://maksimveretennikov.github.io/ww2-daily/

# DRY_RUN=1 prints everything and writes no posts (safe for local testing).
DRY_RUN=0
