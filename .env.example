# Copy these into the routine's Environment variables (claude.ai/code routine settings).
# .env format: KEY=value per line, no quotes around values.

# --- Telegram (required) ---
# Token from @BotFather for the bot that posts to the channel.
TELEGRAM_BOT_TOKEN=
# Channel to post into. The bot must be an admin with posting rights.
TELEGRAM_CHANNEL=@ww2_dnevnik

# --- X cross-post (optional) ---
# Two ways to also post the short English version to X. Polls are never
# cross-posted (Buffer/X can't do quiz polls).
#
# (A) Buffer with photo, free: a tiny make.com scenario (Webhook -> Buffer
#     Create Status with media.picture). Paste its webhook URL here. The routine
#     POSTs {"text": ..., "image_url": ...} to it. Takes priority over the X API.
BUFFER_WEBHOOK_URL=
#
# (B) X API directly (with photo, pay-per-use ~$0.01/post). Set X_ENABLED=1 and
#     fill the keys. Used only if BUFFER_WEBHOOK_URL is empty.
X_ENABLED=0
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# --- Behaviour ---
# --- VK cross-post (optional) ---
# Mirror each post (daily + evening rubric) to a VK community you own.
# Token must be a USER token with scopes: wall,photos,groups,offline.
VK_ACCESS_TOKEN=
VK_GROUP_ID=
# Optional footer appended to VK posts, e.g. a link back to Telegram:
VK_FOOTER=

# DRY_RUN=1 prints everything and writes no posts (safe for local testing).
DRY_RUN=0
